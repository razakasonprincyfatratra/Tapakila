generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketAccessType {
  SINGLE_DAY   // valable pour un seul EventDay précis
  MULTI_DAY    // valable pour un sous-ensemble d'EventDay précis (ex: ven+sam)
  FULL_PASS    // valable pour tous les jours de l'événement (implicite, y compris jours ajoutés après coup)
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String?
  firstName     String
  lastName      String
  role          Role          @default(PARTICIPANT)
  googleId      String?       @unique
  facebookId    String?       @unique
  avatarUrl     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  events                  Event[]                 @relation("OrganizerEvents")
  reservations            Reservation[]
  comments                Comment[]
  organizerApplications   OrganizerApplication[]  @relation("Applicant")
  reviewedApplications    OrganizerApplication[]  @relation("Reviewer")
  checkedInReservations   Reservation[]           @relation("CheckedInReservations")
  checkedInDays           CheckIn[]               @relation("CheckedInDays")
}

model OrganizerApplication {
  id                   String                      @id @default(uuid())
  userId               String
  user                 User                        @relation("Applicant", fields: [userId], references: [id])
  organizationName     String
  phone                String
  email                String
  description          String
  idDocumentUrl        String
  businessRegistryUrl  String?
  logoUrl              String?
  status               OrganizerApplicationStatus  @default(PENDING)
  rejectionReason      String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?                       @relation("Reviewer", fields: [reviewedById], references: [id])
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([status])
}

model Event {
  id              String        @id @default(uuid())
  title           String
  description     String
  category        String
  region          String
  location        String
  latitude        Float?
  longitude       Float?
  startDate       DateTime
  endDate         DateTime?
  coverImageUrl   String?
  images          String[]      @default([])
  videoUrl        String?
  totalCapacity   Int
  conditions      String?
  refundPolicy    String?
  status          EventStatus   @default(DRAFT)
  organizerId     String
  organizer       User          @relation("OrganizerEvents", fields: [organizerId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ticketTypes     TicketType[]
  reservations    Reservation[]
  comments        Comment[]
  eventDays       EventDay[]

  @@index([status])
  @@index([category])
  @@index([region])
}

/// Une ligne par jour d'un festival multi-jours. Un Event "classique" (mono-jour)
/// n'a simplement aucune ligne EventDay : le check-in continue de fonctionner
/// via les champs existants sur Reservation, aucune migration de logique requise
/// pour les événements non-festival.
model EventDay {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date        DateTime
  label       String?   // ex: "Jour 1 - Ouverture", "Vendredi"
  startTime   DateTime?
  endTime     DateTime?
  order       Int       @default(0)

  ticketTypeDays TicketTypeEventDay[]
  checkIns       CheckIn[]

  @@unique([eventId, date])
  @@index([eventId])
}

model TicketType {
  id             String        @id @default(uuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  name           String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  totalSeats     Int
  availableSeats Int
  seatMapZone    String?
  salesStart     DateTime?
  salesEnd       DateTime?
  isActive       Boolean       @default(true)
  order          Int           @default(0)
  accessType     TicketAccessType @default(SINGLE_DAY)

  reservations   Reservation[]
  eventDays      TicketTypeEventDay[] // vide si accessType = FULL_PASS (accès implicite à tous les jours)
}

/// Table de jointure : jours couverts par un TicketType donné.
/// Utilisée uniquement pour SINGLE_DAY (1 ligne) et MULTI_DAY (n lignes).
/// Pour FULL_PASS, aucune ligne n'est créée : l'accès à tous les jours est
/// implicite et reste valide même si l'organisateur ajoute un jour après coup.
model TicketTypeEventDay {
  id           String     @id @default(uuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  eventDayId   String
  eventDay     EventDay   @relation(fields: [eventDayId], references: [id], onDelete: Cascade)

  @@unique([ticketTypeId, eventDayId])
  @@index([eventDayId])
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id])
  ticketTypeId   String
  ticketType     TicketType        @relation(fields: [ticketTypeId], references: [id])
  quantity       Int
  totalAmount    Decimal           @db.Decimal(10, 2)
  status         ReservationStatus @default(PENDING)
  qrCode         String?           @unique
  backupCode     String?           @unique
  paymentRef     String?
  checkedInAt    DateTime?
  checkedInById  String?
  checkedInBy    User?             @relation("CheckedInReservations", fields: [checkedInById], references: [id])
  createdAt      DateTime          @default(now())

  // Check-in par jour, utilisé uniquement pour les événements multi-jours
  // (event.eventDays non vide). Pour un événement mono-jour, checkedInAt
  // ci-dessus reste la seule source de vérité et checkIns restera vide.
  checkIns       CheckIn[]

  @@index([qrCode])
  @@index([backupCode])
}

/// Check-in d'une réservation pour un jour précis d'un festival multi-jours.
/// Un pass "FULL_PASS" peut ainsi être badgé chaque jour ; un pass "SINGLE_DAY"
/// n'aura jamais qu'une seule ligne ici.
model CheckIn {
  id             String       @id @default(uuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventDayId     String
  eventDay       EventDay     @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  checkedInAt    DateTime     @default(now())
  checkedInById  String?
  checkedInBy    User?        @relation("CheckedInDays", fields: [checkedInById], references: [id])

  @@unique([reservationId, eventDayId])
  @@index([eventDayId])
}

model Comment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])
  content     String
  rating      Int?
  createdAt   DateTime  @default(now())
}
